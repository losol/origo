{
  "name": "@eventuras/vite-config",
  "version": "0.2.2",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/losol/origo.git",
    "directory": "config/vite-config"
  },
  "type": "module",
  "exports": {
    "./base": {
      "types": "./dist/base.d.ts",
      "import": "./dist/base.js"
    },
    "./react-lib": {
      "types": "./dist/react-lib.d.ts",
      "import": "./dist/react-lib.js"
    },
    "./vanilla-lib": {
      "types": "./dist/vanilla-lib.d.ts",
      "import": "./dist/vanilla-lib.js"
    },
    "./next-lib": {
      "types": "./dist/next-lib.d.ts",
      "import": "./dist/next-lib.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "dev": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepack": "pnpm run clean && pnpm run build"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.2",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitejs/plugin-react-swc": "^4.3.0",
    "glob": "^13.0.6",
    "vite-plugin-dts": "^5.0.3"
  },
  "devDependencies": {
    "@eventuras/typescript-config": "workspace:*",
    "@types/node": "^24.12.0",
    "typescript": "^6.0.2",
    "vite": "^8.1.0"
  },
  "peerDependencies": {
    "vite": "^7.0.0 || ^8.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
